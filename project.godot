; Engine configuration file.
; Bookish Potato: The First Edition — Godot 4.7 desktop crawler
config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=false

[application]

config/name="Bookish Potato: The First Edition"
config/description="A turn-based dungeon crawler. Unidentified editions. Collate or crack the spine."
config/version="0.1.0"
config/tags=PackedStringArray("roguelike", "2d")
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.05, 0.04, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Persist="*res://scripts/autoload/persist.gd"
AudioMgr="*res://scripts/autoload/audio_mgr.gd"
SteamGate="*res://scripts/autoload/steam_gate.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.02, 1)
